# Copy this file to .env and fill in values before running docker-compose.
#
# cp .env.example .env
# docker-compose up -d

# PostgreSQL password (default: "changeme" — CHANGE THIS in production)
POSTGRES_PASSWORD=changeme

# API key for the CodeMap server.
# If set, all requests must include the header: X-Api-Key: <value>
# Leave empty to disable auth (safe for local dev, not for public deployments).
CODEMAP_API_KEY=

# Port the CodeMap web server listens on (default: 8000)
CODEMAP_PORT=8000

# Anthropic API key — enables AI-powered natural-language graph search.
# When set, the ⌘K palette's Enter key sends queries to Claude Haiku.
# Leave empty to use keyword-only search (always available, no API cost).
ANTHROPIC_API_KEY=
